@page "/Zodiaq"

@using Microsoft.Extensions.Localization;
@using QBNsite.Resources;
@using QBNsite.Helper;

@inject IStringLocalizer<HomeLocales> L
@inject NavigationManager NavManager
@inject Helper HelperInstance;

@code {
	private void GoHome()
	{
		NavManager.NavigateTo(HelperInstance.homePath);
	}

	string wipImagePath => HelperInstance.homePath + "Images/png/WIP.png";
}

<link href="css/PortfolioPages.css" rel="stylesheet" />

<PageTitle>Zodiaq</PageTitle>

<div class="page-container">

	<div class="main-content">
		<div class="container">

			<div class="card">
				<div class="card-block">
					<h2>@L["AboutMe"]</h2>
					<p>
						@L["AboutMeDesc"]
					</p>
				</div>
			</div>
		</div>

	</div>
</div>

