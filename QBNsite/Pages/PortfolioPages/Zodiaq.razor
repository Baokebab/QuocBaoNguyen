@page "/Zodiaq"

@using Microsoft.Extensions.Localization;
@using QBNsite.Helper;
@using QBNsite.Helper.Portfolio.PortfolioItems
@using QBNsite.Resources;

@inject IStringLocalizer<HomeLocales> L
@inject IStringLocalizer<PortfolioLocales> PortfolioL
@inject NavigationManager NavManager


@code {
	private PortfolioItem thisPortfolioItem;
	protected override void OnInitialized()
	{
		thisPortfolioItem = new ZodiaqPI(PortfolioL);
		Selected = thisPortfolioItem.visuals.FirstOrDefault();
	}

	private PortfolioCarouselItem? Selected;
	private void Select(PortfolioCarouselItem v) => Selected = v;
}

<link href="css/PortfolioPages.css" rel="stylesheet" />

<PageTitle>Quoc-Bao Nguyen</PageTitle>

<div class="page-container">

	<div class="main-content">
		<div class="container">

			<div class="card">
				<div class="card-block">
					<h2> Videos </h2>
					<div class="player">
						<div class="player-frame">
							@if (Selected is not null)
							{
								if (Selected.itemType == PortfolioItemType.YoutubeVideo)
								{
										<iframe width="560" height="315"
												src=@Selected.EmbedUrl
												title=@Selected.title
												allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
												allowfullscreen>
										</iframe>
								}
								else
								{
									<img width="560" height="315"
										 src=@Selected.link />
								}
							}
						</div>
					</div>
					<div class="thumbs" role="listbox">
						@foreach (var item in thisPortfolioItem.visuals)
						{

							var isActive = item.link == Selected.link;
							<button type="button"
									class="thumb @(isActive ? "active" : null)"
									@onclick="() => Select(item)"
									aria-pressed="@(isActive)"
									title=@item.title>

								@if (item.itemType == PortfolioItemType.YoutubeVideo)
								{
									<img src=@item.Thumbnail alt=""
										 loading="lazy" decoding="async" />
								}
								else
								{
									<img src=@item.fixedPngPath />
								}

								@if (isActive)
								{
									<span class="thumb-title"> <b> @item.title </b> </span>
								}
								else
								{
									<span class="thumb-title"> @item.title </span>
								}

							</button>
						}
					</div>
				</div>
			</div>

			<div class="card">

				@for (int i = 0; i < thisPortfolioItem.detailsItems.Count; i++)
				{
					<div class="card-block">
						<h2>@thisPortfolioItem.detailsItems[i].title</h2>
						<p>
							@thisPortfolioItem.detailsItems[i].description
						</p>
					</div>
				}

			</div>

		</div>
	</div>

</div>
