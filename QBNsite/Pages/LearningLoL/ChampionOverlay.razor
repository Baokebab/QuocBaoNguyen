@using QBNsite.Helper;
@using QBNsite.Pages.LearningLoL.QuestionsType
@inject IJSRuntime JS

@code {

	[Parameter] public ChampionsDetails SelectedChampion { get; set; } = new ChampionsDetails();
	[Parameter] public int currentChampionIndex { get; set; } = -1;
	[Parameter] public bool isRandomMode { get; set; } = false;
	[Parameter] public EventCallback OnClose { get; set; }
	[Parameter] public int activeTab { get; set; } = 1;

	private Spell SelectedSpell = new Spell();
	MultipleChoiceQuestion currentQuestion;

	protected override void OnParametersSet()
	{
		if (SelectedChampion != null && SelectedChampion.Spells.Count > 0)
		{
			SelectedSpell = SelectedChampion.Spells.First();
			currentQuestion = GenerateNewQuestion();
		}
	}

	private void InitializeMcq()
	{
		currentQuestion = GenerateNewQuestion();
	}

	private MultipleChoiceQuestion GenerateNewQuestion()
	{
		int newQuestionIndex = McqManager.GetNextUnansweredQuestion(SelectedChampion, SelectedChampion.Mcq.IndexOf(currentQuestion));
		MultipleChoiceQuestion newQuestion;
		if (newQuestionIndex == -1)
		{
			newQuestion = new MultipleChoiceQuestion
			{
				Id = $"{SelectedChampion.Name}_NoMoreQuestion",
				Type = McqManager.QuestionType.AllQuestionsAnswered,
				QuestionPrompt = "Tu as répondu correctement à chaque question pour ce champion. Veux tu les refaire? ",
				Answers = new string[2] { "Oui", "Non" },
			};
		}
		else
		{
			newQuestion = SelectedChampion.Mcq[newQuestionIndex];
			currentQuestion = newQuestion;
		}

		return newQuestion;
	}

	void LoadNextQuestion()
	{
		currentQuestion = GenerateNewQuestion();
	}

	void OnAllQuestionAnsweredNext(bool resetQuestions)
	{
		if (resetQuestions)
		{
			for (int i = 0; i < SelectedChampion.Mcq.Count; i++)
			{
				SelectedChampion.Mcq[i].hasBeenCorrectlyAnswered = false;
			}

			SelectedChampion.IsLockedFromRandom = false;

			currentQuestion = GenerateNewQuestion();
		}
		else
		{
			SelectedChampion.IsLockedFromRandom = true;
			LoadNextChampion();
		}
	}

	void ValidateQuestion(bool hasAnsweredCorrectly)
	{
		currentQuestion.hasBeenCorrectlyAnswered = hasAnsweredCorrectly;
	}

	private void SelectSpell(Spell spell)
	{
		SelectedSpell = spell;
	}

	private void CloseOverlay()
	{
		OnClose.InvokeAsync();
	}

	void LoadNextChampion()
	{
		int nextIndex;
		nextIndex = isRandomMode ? ChampionsManager.GetRandomUnlockedChampionIndex(ChampionsManager.ChampionsData, currentChampionIndex)
			: ChampionsManager.GetNextUnlockedChampionIndex(ChampionsManager.ChampionsData, currentChampionIndex);
		if (nextIndex == -1)
		{
			SelectedChampion = null;
			return;
		}
		SelectedChampion = ChampionsManager.ChampionsData[nextIndex];
		currentChampionIndex = nextIndex;
		InitializeMcq();
	}

	void LoadPreviousChampion()
	{
		int prevIndex = (currentChampionIndex - 1 + ChampionsManager.ChampionsData.Count) % ChampionsManager.ChampionsData.Count;
		SelectedChampion = ChampionsManager.ChampionsData[prevIndex];
		currentChampionIndex = prevIndex;
		InitializeMcq();
	}

	string baseBackgroundImageUrl => "https://ddragon.leagueoflegends.com/cdn/img/champion/splash/";
}

@if (SelectedChampion != null)
{
	<div class="overlay-background" @onclick="CloseOverlay">
		<div class="overlay-panel" @onclick:stopPropagation="true"
			 style="background-image: url('@(baseBackgroundImageUrl + SelectedChampion.Id + "_0.jpg")');
		                background-size: cover;
		                background-position: center;">

			<div class="overlay-panel-header">

				@* <button @onclick="LoadPreviousChampion"> Prev </button> *@
				<div class="title">@SelectedChampion.Name</div>
				<button @onclick="() => { isRandomMode = false; LoadNextChampion(); }">  -> @(ChampionsManager.GetNextUnlockedChampionName(ChampionsManager.ChampionsData, currentChampionIndex)) </button>
				<button @onclick="() => { isRandomMode = true; LoadNextChampion(); }">  Random </button>
				<div class="actions">
					<button class="tab-btn @(activeTab == 1 ? "active" : "")"
							@onclick="() => activeTab = 1">
						Quizz
					</button>
					<button class="tab-btn @(activeTab == 2 ? "active" : "")"
							@onclick="() => activeTab = 2">
						Info
					</button>
					<button class="close-btn" @onclick="CloseOverlay">X</button>
				</div>
			</div>

			@if (activeTab == 1)
			{
				<div class="overlay-question-content">
					@if (currentQuestion != null)
					{
						switch (currentQuestion.Type)
						{
							case McqManager.QuestionType.YesNo:
								<YesNoQuestion @key="currentQuestion"
											   Question="@currentQuestion.QuestionPrompt"
											   CorrectAnswer="@currentQuestion.CorrectAnswers[0]"
											   Commentary="@currentQuestion.Commentary"
											   SpellsToShow="@currentQuestion.SpellsToShow"
											   OnNext="LoadNextQuestion"
											   OnAnswerValidated="ValidateQuestion" />
								break;

							case McqManager.QuestionType.AllQuestionsAnswered:
								<ResetQuestions @key="currentQuestion"
												Question="@currentQuestion.QuestionPrompt"
												OnNext="OnAllQuestionAnsweredNext" />
								break;
						}
					}
				</div>
			}
			else if (activeTab == 2)
			{
				<div class="overlay-champion-content">
					<div class="spells-column">
						@foreach (var spell in SelectedChampion.Spells)
						{
							<div class="spell-card @(SelectedSpell.Name == spell.Name ? "selected" : "")"
								 @onclick="() => SelectSpell(spell)">
								<img src="@spell.IconLink" alt="@spell.Name" />
								<span>@spell.Slot - @spell.Name</span>
							</div>
						}
					</div>

					<div class="spell-details">
						@if (SelectedSpell != null)
						{
							<video width="100%" autoplay loop muted @key="SelectedSpell.VideoLink">
								<source src="@SelectedSpell.VideoLinkWebm" type="video/webm" />
								<source src="@SelectedSpell.VideoLink" type="video/mp4" />
							</video>

							<p class="spell-description">@SelectedSpell.Description</p>

							@if (SelectedSpell.SpellAttributes.Count > 0)
							{
								@foreach (var attr in SelectedSpell.SpellAttributes)
								{
									<strong>@attr.ToString()  &nbsp </strong>
								}
							}
						}
					</div>

				</div>
			}


		</div>
	</div>
}


