@using QBNsite.BlazorComp
@using QBNsite.Helper;
@inject Helper HelperInstance;

@code {


	[Parameter] public MultipleChoiceQuestion Question { get; set; }
	[Parameter] public EventCallback OnNext { get; set; }
	[Parameter] public EventCallback<bool> OnAnswerValidated { get; set; }
	[Parameter] public HashSet<string> SelectedItemLabels { get; set; }

	bool AreAnswersValidated = false;

	public class CheckItem
	{
		public string Label { get; set; }
		public string Icon { get; set; }
		public bool IsChecked { get; set; }
		public bool IsCorrectAnswer { get; set; }
	}

	List<CheckItem> Items = new List<CheckItem>();

	protected override void OnInitialized()
	{
		for (int i = 0; i < Question.Answers.Length; i++)
		{
			Items.Add(new CheckItem
			{
				Label = Question.Answers[i].AnswerText,
				Icon = Question.Answers[i].IconLink,
				IsCorrectAnswer = Question.Answers[i].IsCorrectAnswer,
				IsChecked = false
			});
		}

	}

	void Toggle(CheckItem item)
	{
		SelectedItemLabels.Clear();
		item.IsChecked = !item.IsChecked;
		if (item.IsChecked)
		{
			SelectedItemLabels.Add(item.Label);
			for(int i = 0; i < Items.Count; i++)
			{
				if (Items[i] == item) continue;
				Items[i].IsChecked = false; 
			}
		}
	}

	async Task ValidateUserChoices()
	{
		if (!AreAnswersValidated) {
			AreAnswersValidated = true;
			await OnAnswerValidated.InvokeAsync(IsUserCorrect());
		}
		else
		{
			AreAnswersValidated = false;
			await OnNext.InvokeAsync();
		}
	}

	private bool IsUserCorrect()
	{
		for(int i = 0; i < Items.Count; i++)
		{
			if (Items[i].IsChecked != Items[i].IsCorrectAnswer)
				return false;
		}
		return true;
	}

	private string IsCheckBoxSelected(CheckItem checkItem)
	{
		if(checkItem.IsChecked)
		{
			return "selected";
		}
		else if (SelectedItemLabels.Contains(checkItem.Label))
		{
			checkItem.IsChecked = true;
			return "selected";
		}

		return "";
	}
}

<div class="multiple-checkbox-question">
	<div class="multiple-checkbox-question-content">

		<div class="question-text">@Question.QuestionPrompt</div>
		<VideoSpoiler 
			SourceWebm="@Question.SpellsToShow.First().VideoLinkWebm"
			SourceMp4="@Question.SpellsToShow.First().VideoLink" />

		<div class="options-container">
			@for(int i = 0; i < Items.Count; i++) 
			{
				var item = Items[i];
				<div class="option-box @(IsCheckBoxSelected(item))
							@(AreAnswersValidated && item.IsChecked ? (item.IsCorrectAnswer ? "good" : "bad") : (AreAnswersValidated && !item.IsChecked && item.IsCorrectAnswer ? "forgotten" : ""))
							@(AreAnswersValidated ? "disabled" : "")"
					 @onclick="() => Toggle(item)">

					@if (!string.IsNullOrWhiteSpace(item.Icon))
					{
						<img src="@item.Icon" class="option-icon" />
					}

					<div class="option-label">@item.Label</div>

					<input type="checkbox"
						   @bind="item.IsChecked"
						   class="hidden-checkbox" />
				</div>
			}
		</div>

		<div class="next-container">
			<button class="next-btn" @onclick="ValidateUserChoices"> 
				@(!AreAnswersValidated ? "Check" : " Suivant → ")
			</button>
		</div>

		@if (AreAnswersValidated)
		{
			if (IsUserCorrect())
			{
				<audio autoplay>
					<source src="@AudioManager.GetAudioPathForCorrectAnswer(HelperInstance.homePath)" type="audio/mp3" />
				</audio>
				AudioManager.GoodAnswerCount = (AudioManager.GoodAnswerCount + 1) % 5;
			}
			else
			{
				<audio autoplay>
					<source src="@AudioManager.GetAudioPathForWrongAnswer(HelperInstance.homePath)" type="audio/mp3" />
				</audio>
				AudioManager.GoodAnswerCount = 0;
			}

			if (!string.IsNullOrWhiteSpace(Question.Commentary))
			{
				<div class="comment-block">
					@Question.Commentary
				</div>
			}

			foreach (var spell in Question.SpellsToShow)
			{
				<div class="spell-answer-display">
					<img src="@spell.IconLink" alt="@spell.Name" />
					<span>@spell.Slot - @spell.Name</span>
					<span>@spell.Description</span>
				</div>
			}
		}

	</div>

</div>
