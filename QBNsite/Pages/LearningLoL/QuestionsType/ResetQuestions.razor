@using Microsoft.Extensions.Localization
@using QBNsite.Resources.League;
@inject IStringLocalizer<LeagueLocales> Locales


@code {
	[Parameter] public string Question { get; set; }
	[Parameter] public EventCallback<bool> OnNext { get; set; }

	bool? UserChoice = null;

	async Task Select(bool choix)
	{
		UserChoice = choix;
		bool finalChoice = UserChoice == null ? false : UserChoice.Value;
		UserChoice = null;
		await OnNext.InvokeAsync(finalChoice);
	}
}

<div class="yn-question">
	<div class="yn-question-content">
		<div class="question-text">@Question</div>

		<div class="answers">
			<button class="answer-btn @(UserChoice == true ? "selected" : "")"
					@onclick="() => Select(true)">
				@Locales["Yes"]
			</button>

			<button class="answer-btn @(UserChoice == false ? "selected" : "")"
					@onclick="() => Select(false)">
				@Locales["No"]
			</button>
		</div>
	</div>

</div>
