
@code {
	[Parameter] public string Question { get; set; }
	[Parameter] public EventCallback<bool> OnNext { get; set; }

	bool? UserChoice = null;

	void Select(bool choix)
	{
		UserChoice = choix;
	}

	async Task Next()
	{
		bool finalChoice = UserChoice == null ? false : UserChoice.Value;
		UserChoice = null;
		await OnNext.InvokeAsync(finalChoice);
	}
}

<div class="yn-question">
	<div class="yn-question-content">
		<div class="question-text">@Question</div>

		<div class="answers">
			<button class="answer-btn @(UserChoice == true ? "good" : "")"
					@onclick="() => Select(true)">
				Oui
			</button>

			<button class="answer-btn @(UserChoice == false ? "bad" : "")"
					@onclick="() => Select(false)">
				Non
			</button>
		</div>
	</div>

	@if (UserChoice != null)
	{
		<div class="next-container">
			<button class="next-btn" @onclick="Next">Suivant →</button>
		</div>
	}

</div>
