@using QBNsite.Helper;
@inject Helper HelperInstance;

@code {
	[Parameter] public MultipleChoiceQuestion Question { get; set; }
	[Parameter] public EventCallback OnNext { get; set; }
	[Parameter] public EventCallback<bool> OnAnswerValidated { get; set; }

	int UserChoice = -1;
	bool AreButtonsDisabled = false;

	void Select(int choix)
	{
		//0 = YES, 1 = NO
		UserChoice = choix;
		AreButtonsDisabled = true;
		OnAnswerValidated.InvokeAsync(Question.Answers[UserChoice].IsCorrectAnswer);
	}

	async Task Next()
	{
		UserChoice = -1;
		AreButtonsDisabled = false;
		await OnNext.InvokeAsync();
	}
}

<div class="yn-question">
	<div class="yn-question-content">
		<div class="question-text">@Question.QuestionPrompt</div>

		<div class="answers">
			<button class="answer-btn @(UserChoice == 0 ? (Question.Answers[0].IsCorrectAnswer ? "good" : "bad") : "")"
					@onclick="() => Select(0)" disabled="@AreButtonsDisabled">
				@Question.Answers[0].AnswerText
			</button>

			<button class="answer-btn @(UserChoice == 1 ? (Question.Answers[1].IsCorrectAnswer ? "good" : "bad") : "")"
					@onclick="() => Select(1)" disabled="@AreButtonsDisabled">
				@Question.Answers[1].AnswerText
			</button>
		</div>

		@if (UserChoice != -1)
		{

			if (!string.IsNullOrWhiteSpace(Question.Commentary))
			{
				<div class="comment-block">
					@Question.Commentary
				</div>
			}

			if (Question.Answers[UserChoice].IsCorrectAnswer)
			{
				<audio autoplay>
					<source src="@AudioManager.GetAudioPathForCorrectAnswer(HelperInstance.homePath)" type="audio/mp3" />
				</audio>
			}
			else
			{
				<audio autoplay>
					<source src="@AudioManager.GetAudioPathForWrongAnswer(HelperInstance.homePath)" type="audio/mp3" />
				</audio>
			}

			<div class="next-container">
				<button class="next-btn" @onclick="Next">Suivant →</button>
			</div>

			foreach (var spell in Question.SpellsToShow)
			{
				<div class="spell-answer-display">
					<img src="@spell.IconLink" alt="@spell.Name" />
					<span>@spell.Slot - @spell.Name</span>
					<span>@spell.Description</span>

					<video width="100%" autoplay loop muted>
						<source src="@spell.VideoLinkWebm" type="video/webm" />
						<source src="@spell.VideoLink" type="video/mp4" />
					</video>
				</div>
			}


		}
	</div>

</div>
