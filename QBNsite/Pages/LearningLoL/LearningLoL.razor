@page "/LearningLoLChamps"

@using Microsoft.Extensions.Localization;
@using QBNsite.BlazorComp
@using QBNsite.Helper;
@using QBNsite.Resources.League;


@inject IStringLocalizer<LeagueLocales> Locales
@inject IJSRuntime JS
@inject NavigationManager NavManager
@inject Helper HelperInstance;
@inject HttpClient Http

@code {
	private void GoHome()
	{
		NavManager.NavigateTo(HelperInstance.homePath);
	}

	string ExportCsv = "Champions,SpellId,SpellName,SpellSlot,PhysicalDamage,MagicDamage,TrueDamage";

	protected override async Task OnInitializedAsync()
	{
		ChampionsManager.ChampionsData = new List<ChampionsDetails>();

		string csvRelativePath = Path.Combine(HelperInstance.homePath, LeagueHelper.localCsvPath);
		string csvChampionsRelativePath = Path.Combine(HelperInstance.homePath, LeagueHelper.localChampionPath);
		Dictionary<string, List<SpellAttribute>> csvDataDict;
		Dictionary<string, ChampionsCsvDetails> csvChampionDict; 

		try
		{
			 csvDataDict = await LeagueHelper.LoadSpellCsvAttributes(Http, LeagueHelper.csvUrl);

		}
		catch(Exception e)
		{
			Console.WriteLine(e);
			 csvDataDict = await LeagueHelper.LoadSpellCsvAttributes(Http, csvRelativePath);
		}
		try
		{
			 csvChampionDict = await LeagueHelper.LoadChampionCsv(Http, LeagueHelper.champCsvUrl);
		}
		catch(Exception e)
		{
			Console.WriteLine(e);
			 csvChampionDict = await LeagueHelper.LoadChampionCsv(Http, csvChampionsRelativePath);
		}
		

		var versions = await Http.GetFromJsonAsync<List<string>>(LeagueHelper.leagueVersion);

		if (versions == null || versions.Count == 0) return;
		var version = versions.First();

		string curVerBaseUrl = LeagueHelper.GetCurrentVersionUrl(version);
		var root = await Http.GetFromJsonAsync<ChampionRoot>(
			$"{curVerBaseUrl}/data/{Locales["Localisation"]}/champion.json"
		);
		if (root == null) return;

		int j = 0; 
		foreach (var kvp in root.Data)
		{
			if (j >= 10) break;

			var dto = kvp.Value;

			var detailRoot = await Http.GetFromJsonAsync<ChampionDetailRoot>(
			$"{curVerBaseUrl}/data/{Locales["Localisation"]}/champion/{dto.Id}.json"
		);

			if (detailRoot == null) continue;

			var detail = detailRoot.Data[dto.Id];
			var keyInt = int.Parse(dto.Key);
			var padded = keyInt.ToString("D4");


			var champ = new ChampionsDetails
			{
				Id = dto.Id,
				Name = dto.Name,
				Genre = csvChampionDict[dto.Id].Genre,
				IconLink = $"{curVerBaseUrl}/img/champion/{dto.Image.full}",
				NumberOfSkins = detail.Skins.Count,
			};

			string[] slots = { "P1", "Q1", "W1", "E1", "R1" };

			for (int i = 0; i < slots.Length; i++)
			{
				var slot = slots[i];
				Spell currentSpell;

				if (i == 0)
				{
					currentSpell = new Spell(
						slot,
						detail.Passive.Name,
						detail.Passive.Image.full,
					HelperInstance.StripHtml(detail.Passive.Description),
					"",
					$"{curVerBaseUrl}/img/passive/{detail.Passive.Image.full}",
					$"{LeagueHelper.baseSpellVideoUrl}/{padded}/ability_{padded}_{slot}.mp4"
					);
				}
				else
				{
					currentSpell = new Spell(
					slot,
					detail.Spells[i - 1].Name,
					detail.Spells[i - 1].Id,
						HelperInstance.StripHtml(detail.Spells[i - 1].Description),
						/* HelperInstance.StripHtml(detail.Spells[i - 1].Tooltip) */ detail.Spells[i - 1].Tooltip,
					$"{curVerBaseUrl}/img/spell/{detail.Spells[i - 1].Id}.png",
					$"{LeagueHelper.baseSpellVideoUrl}/{padded}/ability_{padded}_{slot}.mp4"
					);
				}

				if(csvDataDict.ContainsKey(currentSpell.Id))
				{
					currentSpell.SpellAttributes = csvDataDict[currentSpell.Id];
				}

				champ.Spells.Add(currentSpell);

				// ExportCsv += $"\n{champ.Name},{currentSpell.Id},{currentSpell.Name},{currentSpell.Slot}";

				// if (currentSpell.Tooltip.Contains("<physicalDamage>", StringComparison.CurrentCultureIgnoreCase))
				// {
				// 	ExportCsv += ",1";
				// }
				// if (currentSpell.Tooltip.Contains("<magicDamage>", StringComparison.CurrentCultureIgnoreCase))
				// {
				// 	ExportCsv += ",1";
				// }
				// if (currentSpell.Tooltip.Contains("<trueDamage>", StringComparison.CurrentCultureIgnoreCase))
				// {
				// 	ExportCsv += ",1";
				// }
			}

			champ.Mcq = McqManager.GenerateAllMcq(champ);
			Helper.Shuffle(champ.Mcq);
			ChampionsManager.ChampionsData.Add(champ);
			j++;
		}
	}

	private async Task DownloadCsv()
	{
		var bytes = System.Text.Encoding.UTF8.GetBytes(ExportCsv);

		using var streamRef = new DotNetStreamReference(new MemoryStream(bytes));

		await JS.InvokeVoidAsync(
			"downloadFileFromStream",
			"LearningLoLExport.csv",
			streamRef
		);
	}

	private string SearchText = "";

	private List<ChampionsDetails> FilteredChampions =>
				ChampionsManager.ChampionsData.Where(c =>
					string.IsNullOrWhiteSpace(SearchText)
					|| c.Name.Contains(SearchText, StringComparison.OrdinalIgnoreCase)
				).ToList();

	private ChampionsDetails SelectedChampion; 
	private int SelectedChampionIndex;
	private bool isRandomModeOn = false; 

	private void OpenOverlay(ChampionsDetails champ, int currentIndex, bool isRandom = false)
	{
		SelectedChampion = champ;
		SelectedChampionIndex = currentIndex;
		isRandomModeOn = isRandom;
	}

	private void CloseOverlay()
	{
		SelectedChampion = null;
	}
}

<PageTitle>Learning LoL Champions</PageTitle>

@* <button @onclick="DownloadCsv">Télécharger CSV</button> *@

<div class="search-container">
	<input type="text" placeholder="Rechercher un champion..."
		   @bind="SearchText" @bind:event="oninput" />
</div>


<Toggle @bind-Value="McqManager.IgnoreResetQuestion"
		Label="@(new string[]{"Refus Auto du Reset On","Refus Auto du Reset Off" })" />
<Toggle @bind-Value="McqManager.AllRandomAllChampions"
		Label="@(new string[]{"Random Question Random Champion On", "Random Question Random Champion Off " })" />


<div class="champion-grid">

	<div class="champion-card">
		@{
			var randomIndex = new Random().Next(0, ChampionsManager.ChampionsData.Count);
		<img src="https://wiki.leagueoflegends.com/en-us/images/Arena_Bravery_square.png" alt="All champions Random"
				 @onclick="() => OpenOverlay(ChampionsManager.ChampionsData[randomIndex], randomIndex, true)" />
		 }
	</div>
	@for (int i = 0; i < FilteredChampions.Count; i++)
	{
		var champ = FilteredChampions[i];
		int champIndex = ChampionsManager.ChampionsData.FindIndex(c => c.Id == champ.Id);

		<div class="champion-card @(champ.IsLockedFromRandom ? "completed" : "")">
			<img src="@champ.IconLink" alt="@champ.Name" @onclick="() => OpenOverlay(champ, champIndex)" />
		</div>
	}

</div>

@if (SelectedChampion != null)
{
	<ChampionOverlay 
		SelectedChampion="SelectedChampion"
		currentChampionIndex="SelectedChampionIndex"
		isRandomMode="isRandomModeOn"
		OnClose="CloseOverlay" />
}





