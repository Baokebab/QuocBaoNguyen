@using Microsoft.Extensions.Localization
@using QBNsite.BlazorComp
@using QBNsite.Helper;
@using QBNsite.Resources.League
@inject IJSRuntime JS
@inject IStringLocalizer<LeagueLocales> Locales

@code {
	[Parameter] public EventCallback OnClose { get; set; }

	private void CloseOverlay()
	{
		OnClose.InvokeAsync();
	}
}

<div class="parameter-overlay-background" @onclick="CloseOverlay">
	<div class="parameter-overlay-panel" @onclick:stopPropagation="true">

		<div class="parameter-overlay-panel-header">
			<div class="parameter-title"> @Locales["Settings"] </div>

			<div class="parameter-actions">
				<button class="parameter-close-btn" @onclick="CloseOverlay">X</button>
			</div>
		</div>

		<div class="parameter-overlay-content">
			<Toggle @bind-Value="McqManager.IgnoreResetQuestion"
					Label="@(new string[]{"Refus Auto du Reset On","Refus Auto du Reset Off" })" />
			<Toggle @bind-Value="McqManager.AllRandomAllChampions"
					Label="@(new string[]{"Random Question Random Champion On", "Random Question Random Champion Off " })" />
			<Toggle @bind-Value="AudioManager.EvoriOnly"
					Label="@(new string[]{"Only Evori Sound On", "Only Evori Sound Off " })" />
		</div>
	</div>
</div>