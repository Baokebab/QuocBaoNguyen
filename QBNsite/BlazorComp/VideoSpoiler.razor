@code {
	private bool showVideo = false;
	[Parameter] public string SourceWebm { get; set; } = "";
	[Parameter] public string SourceMp4 { get; set; } = "";

	private void RevealVideo()
	{
		showVideo = true;
	}
}


<div class="video-container">
	<div class="spoiler-overlay @(showVideo ? "hidden" : "")" @onclick="RevealVideo">
		<div class="spoiler-text">Afficher la vidéo</div>
	</div>

	<video autoplay loop controls muted="false" width="100%">
		<source src="@SourceWebm" type="video/webm" />
		<source src="@SourceMp4" type="video/mp4" />
	</video>
</div>
